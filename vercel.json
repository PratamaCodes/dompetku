{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "^/build/(.*)$",
      "dest": "/public/build/$1"
    },
    {
      "src": "^/(favicon\\.ico|robots\\.txt)$",
      "dest": "/public/$1"
    },
    {
      "src": "^/(.*\\.(css|js|mjs|png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|map))$",
      "dest": "/public/$1"
    },
    {
      "src": "^/storage/(.*)$",
      "dest": "/public/storage/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/index.php"
    }
  ]
}